// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Crop {
  cropCode       String @id
  cropName       String
  cropImage      Bytes
  scientificName String
  category       String
  season         Int
}

model Field {
  fieldCode     String @id
  fieldName     String
  fieldImage    Bytes
  fieldLocation String
}

model Equipment {
  equipmentCode String @id
  equipmentName String
  equipmentType String
}

model Staff {
  email     String @id @unique
  firstName String
  lastName  String
  gender    String
  address   String
  contactNo Int
  jobrole   String
}

model Vehicle {
  licensePlateNo  String @id @unique
  fuelType        String
  color           String
  vehicleCategory String
}

model User {
  userEmail String          @id @unique
  password  String
  role      String
  logs      MonitoringLog[]
}

model MonitoringLog {
  logCode String  @id
  date    String
  User    User?   @relation(fields: [userId], references: [userEmail])
  userId  String? @map("user_email")
}
